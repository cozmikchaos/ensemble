# Optional: only AI analysis requires this key. Never use NEXT_PUBLIC_ for secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Defaults: 3000 and 0.0.0.0. Deploy as ONE long-running Node.js process.
PORT=3000
BIND_HOST=0.0.0.0

# Vercel frontend: public HTTPS URL of the live Node server. Leave blank locally.
NEXT_PUBLIC_SOCKET_URL=
# Backend: exact frontend origins, comma-separated, without trailing slashes.
ALLOWED_ORIGINS=
